.vs/
.vscode/*
!.vscode/settings.json
bin/
obj/
*.user
*.suo
*.sln.DotSettings.user

# Arquivos temporarios do AutoCAD
*.sv$
*.dwl
*.dwl2
*.ac$

# Python — caches e artefatos locais (nunca versionar)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.venv/
venv/
env/
*.egg-info/
build/
dist/*
# EXCECAO: dist/IngeAnalisys.zip E versionado de proposito — e o arquivo que o
# catalogo de extensoes baixa (raw.githubusercontent.com/.../v<versao>/dist/
# IngeAnalisys.zip), entao o SHA-256 dele tem de ser legivel na tag.
!dist/IngeAnalisys.zip
*.spec

# Pasta de trabalho/desenvolvimento local (nao versionada)
Desenvolvimento/

# Saida de compilacao (instaladores sao distribuidos via GitHub Releases)
Output/*.exe
Output/*.zip

